# Copy to .env.local and fill in. NEVER commit .env.local or any real key.
# Values come from the Supabase dashboard: Project Settings > API.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (public) key. Safe for the browser; protected by RLS.
# Do NOT put a secret / service-role key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Private storage bucket created by the storage migration.
NEXT_PUBLIC_STORAGE_BUCKET=rayims-files
